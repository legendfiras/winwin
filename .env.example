VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=
# Optional override. On winwinleb.com the app already uses the Worker API.
# VITE_API_URL=https://winwin.firaskotob508.workers.dev
# Optional: full CDN origin if images are not served from this site at /img/
# VITE_PRODUCT_IMAGE_BASE_URL=https://img.example.com

# Cloudflare Worker only. Never prefix the API key with VITE_.
RESEND_API_KEY=
EMAIL_FROM=WinWin <no-reply@winwinleb.com>

# Server-side marketing email configuration. Keep disabled until consent and a
# dry run have been reviewed. Never expose these as VITE_ variables.
MARKETING_EMAILS_ENABLED=false
MARKETING_DAILY_SEND_LIMIT=90
MARKETING_INACTIVITY_DAYS=3
MARKETING_FROM_EMAIL=WinWin <offers@winwinleb.com>
MARKETING_DRY_RUN=true
MARKETING_TEST_RECIPIENT=
MARKETING_UNSUBSCRIBE_SECRET=
